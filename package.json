{
  "name": "pockit-budget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src server api index.html vite.config.ts vercel.json public/sw.js README.md ACCOUNT_EMAILS.md PASSKEYS.md emails/README.md",
    "format:check": "prettier --check src server api index.html vite.config.ts vercel.json public/sw.js README.md ACCOUNT_EMAILS.md PASSKEYS.md emails/README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
