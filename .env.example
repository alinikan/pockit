VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_VAPID_PUBLIC_KEY=
# Optional. Enable Vercel Speed Insights in your Vercel project first.
# Pockit strips paths, URL query strings, and fragments from performance events.
VITE_ENABLE_SPEED_INSIGHTS=false
# Optional, errors only. Sentry DSNs are public project identifiers, not secrets.
# Leave blank to send no diagnostics to Sentry.
VITE_SENTRY_DSN=
